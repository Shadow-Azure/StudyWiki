{
  "name": "study-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:docs": "node scripts/run-gates.mjs --mode doc-quick",
    "verify:docs": "node scripts/run-gates.mjs --mode doc-sync",
    "verify:release": "node scripts/run-gates.mjs --mode release",
    "verify:env-independence": "node scripts/verify-env-independence.mjs",
    "verify:dep-audit": "node scripts/verify-dep-audit.mjs",
    "verify:layering": "node scripts/verify-layering.mjs",
    "verify:native-links": "node scripts/verify-native-links.mjs",
    "record:i18n": "node scripts/verify-translation-pairing.mjs --write",
    "gen:commands": "node scripts/gen-commands-catalog.mjs",
    "gen:code-map": "node scripts/gen-code-map.mjs",
    "gen:plugin": "node scripts/gen-plugin-template.mjs",
    "verify:commands": "node scripts/gen-commands-catalog.mjs --check",
    "install:hooks": "node scripts/install-git-hooks.mjs",
    "route:gates": "node scripts/route-gates.mjs",
    "archive:note": "node scripts/archive-agent-note.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "codemirror": "^6.0.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
